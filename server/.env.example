# ---- runtime ----
NODE_ENV=development
PORT=4000

# ---- database ----
# Neon example: postgresql://user:pass@ep-xxx.aws.neon.tech/rentroom?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/rentroom?schema=public"

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-48-byte-random-base64-string"
JWT_EXPIRES_IN="1d"

# ---- cors ----
CLIENT_ORIGIN="http://localhost:5173"

# ---- admin seed (used only by `npm run seed:admin`) ----
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_PHONE="+919999999999"

# ---- cloudinary (optional — leave blank to disable photo uploads) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""